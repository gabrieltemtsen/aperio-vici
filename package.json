{
  "name": "aperio-vici",
  "version": "1.0.0",
  "private": true,
  "description": "Aperio Vici Bookshops & Gifts — storefront, bank-transfer order pipeline, walk-in POS and business dashboard.",
  "scripts": {
    "dev": "npm-run-all --parallel dev:next dev:convex",
