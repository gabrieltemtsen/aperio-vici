    "seed": "convex run seed:run",
    "promote": "convex run staff:promoteByEmail"
  },
  "dependencies": {
    "@convex-dev/auth": "^0.0.87",
    "@oslojs/crypto": "^1.0.1",
    "@oslojs/encoding": "^1.1.0",
    "clsx": "^2.1.1",
    "convex": "^1.27.0",
    "lucide-react": "^0.468.0",
    "next": "^15.5.25",
    "react": "19.1.0",
    "react-dom": "19.1.0",
    "tailwind-merge": "^2.6.0",
    "zustand": "^5.0.3"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4.1.13",
    "@types/node": "^22.10.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "npm-run-all": "^4.1.5",
    "tailwindcss": "^4.1.13",
    "typescript": "^5.7.0"
  }
